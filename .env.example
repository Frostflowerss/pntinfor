# ============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật:
#     cp .env.example .env.local
# .env.local KHÔNG BAO GIỜ được commit (đã chặn trong .gitignore).
# ============================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — TUYỆT ĐỐI BÍ MẬT, chỉ dùng phía server.
# Khóa này bypass toàn bộ RLS. Lộ khóa = mất toàn quyền database.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tài khoản quản trị /pntarch ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# BẮT BUỘC. Khóa ký cookie phiên đăng nhập.
# Thiếu biến này, app sẽ báo lỗi khi vào /pntarch (fail-closed, có chủ đích).
# Sinh khóa mới:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Site ---
# Dùng cho metadataBase, sitemap.xml và robots.txt.
# Trên production PHẢI đổi thành domain thật, nếu không OG/sitemap sẽ trỏ localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
